<?xml version="1.0" encoding="utf-8"?>
<!-- W3 Lager heute. Das System weckt das Widget höchstens alle 30 Minuten; dazu kommen die App und der Wechsel zwischen Vordergrund und Hintergrund. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_desc_camp"
    android:initialLayout="@layout/widget_initial"
    android:configure="io.github.sorry4nothing.cevios.widget.WidgetConfigActivity"
    android:widgetFeatures="reconfigurable|configuration_optional"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen|keyguard" />
