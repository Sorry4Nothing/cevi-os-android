<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chip_root"
    android:layout_width="wrap_content"
    android:layout_height="24dp"
    android:layout_marginStart="4dp"
    android:background="@drawable/widget_chip_open"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="8dp">

    <ImageView
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_question"
        android:tint="@color/widget_open_text"
        tools:ignore="UseAppTint" />

    <!-- Der Chip traegt die Beschreibung ("Lena kommt"); der Name allein wuerde doppelt vorgelesen. -->
    <TextView
        android:id="@+id/chip_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:importantForAccessibility="no"
        android:maxWidth="70dp"
        android:singleLine="true"
        android:textColor="@color/widget_open_text"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
