<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chip_root"
    android:layout_width="30dp"
    android:layout_height="30dp"
    android:layout_marginStart="6dp">

    <!-- Der Kreis traegt die Beschreibung ("Lena kommt"); Buchstabe und Badge allein wuerden doppelt vorgelesen. -->
    <TextView
        android:id="@+id/chip_text"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:background="@drawable/widget_dot_yes"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textColor="@color/widget_yes_text"
        android:textSize="12sp"
        android:textStyle="bold" />

    <ImageView
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_gravity="bottom|end"
        android:background="@drawable/widget_badge_yes"
        android:importantForAccessibility="no"
        android:padding="3dp"
        android:src="@drawable/ic_check"
        android:tint="@color/widget_card"
        tools:ignore="UseAppTint" />
</FrameLayout>
